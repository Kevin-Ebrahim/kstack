          "text_edits": [
            {
              "from": "### Phase 3: Report",
              "to": "### Phase 3: Report or fix within scope"
            },
            {
              "from": "Order findings by cost: layout before paint, busy-main-thread before idle. Then stop. Apply fixes when asked.",
              "to": "Order findings by cost: layout before paint, busy-main-thread before idle. For diagnosis or review only, report and stop. When the user already asked to fix or improve the stuttering animation, apply the smallest supported fix without requiring a second request. Repeat the same recording or measurement under comparable conditions, check interruption and reduced motion, and report what changed. Separate code inspection from measured improvement; unavailable device evidence remains unverified."
            }
          ]
        }
