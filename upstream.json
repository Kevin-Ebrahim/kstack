      "files": [
        {
          "path": "SKILL.md",
          "role": "entrypoint",
          "upstream_path": "pstack/skills/typescript-best-practices/SKILL.md",
          "upstream_git_blob": "e1e5aa7c97ed39c425d60d933a96424a3f14539e",
          "upstream_sha256": "ec1dac086d3708e5940d45d250c30a37dd953b4e3cb2ca0692f5851d7a039e27",
          "sha256": "c0f2d504e64ed5948ad6aebf3fd1668f34ee487a02d24cfffde6c81b809b6685",
          "link_rewrites": [],
          "text_edits": [
            {
              "from": "paths: [\"**/*.ts\", \"**/*.tsx\"]\n",
              "to": "",
              "offset": 126
            },
            {
              "from": "Apply the **type-system-discipline** principle skill first.",
              "to": "Apply [type-system-discipline](../principle-type-system-discipline/SKILL.md) first. Use these defaults when reading or editing TypeScript; applicability comes from the task and file type, not a provider-specific path matcher. Follow the repository's established types, schema library, naming, and public API contracts. Avoid unrelated migrations solely to match an example."
            },
            {
              "from": "No optional-field bags.",
              "to": "Avoid optional-field bags when they permit contradictory states."
            },
            {
              "from": "Brand primitives with `& { readonly __brand: \"X\" }` so they can't be mixed up. Validate once at the boundary. A brand comes from a verifying type guard (`input is AgentId`), never from `as`.",
              "to": "Use the repository\\'s existing branded or opaque types where confusing primitives is a real risk. Validate at creation; do not introduce a second branding convention."
            },
            {
              "from": "`start` plus `duration` for a range. Not a runtime guard, not a wish for refinement types.",
              "to": "`start` plus a validated nonnegative duration for a range. Use runtime validation for invariants the type cannot express."
            },
            {
              "from": "Every `as` is a runtime crash waiting. Cast only after validation.",
              "to": "Prefer narrowing or validation over assertions. Keep justified assertions for compiler limitations narrowly scoped; `as const` is not runtime validation."
            },
            {
              "from": "See the **boundary-discipline** principle skill.",
              "to": "Validate external data at entry, preserve that invariant internally, and validate again when a new trust boundary is crossed."
            },
            {
              "from": "Pass objects, not positional, so argument order is self-documenting. Skip on hot paths (per-frame render, tokenizers, parsers).",
              "to": "Prefer named options for easily confused parameters when consistent with the API. Preserve clear positional APIs and hot-path allocation constraints."
            },
            {
              "from": "Examples: `references/patterns.md`.",
              "to": "Examples: [TypeScript patterns](references/patterns.md)."
            }
          ]
        },
        {
          "path": "references/patterns.md",
          "role": "reference",
          "upstream_path": "pstack/skills/typescript-best-practices/references/patterns.md",
          "upstream_git_blob": "f8dd99b63ecb469a090b8fa0a7e235d3239cb9ec",
          "upstream_sha256": "12e70c9419a8b3f5d6a1ab80e272c1f00a43ac0b3bbf72d68199033570e5de77",
          "sha256": "c14c3d85d3db037d6fc3002c4d3aa014505280a7807a191e9f271079a5391e88",
          "link_rewrites": [],
          "text_edits": [
            {
              "from": "See the **type-system-discipline** and **boundary-discipline** principle skills.",
              "to": "See [type-system-discipline](../../principle-type-system-discipline/SKILL.md). Validate external data at entry and preserve established invariants internally."
            },
            {
              "from": "Match the `readonly __brand: 'X'` shape. Don't invent a new convention.",
              "to": "This branding shape is an example. Reuse the repository's established branded or opaque type convention."
            },
            {
              "from": "// Do: a negative range can't be written; derive end when needed",
              "to": "// Derive the end, but validate durationMs >= 0 at construction.\n// A plain number alone does not enforce this invariant."
            },
            {
              "from": "Pick the representation that makes the bad state unconstructable, then expose the reading you need on top",
              "to": "Use a validated constructor or the repository's nonnegative-duration type to enforce the range invariant, then expose the reading you need on top"
            },
            {
              "from": "Every `as` is a potential runtime crash. Cast only after the type system has verified the claim.",
              "to": "Prefer narrowing or validation to assertions. Keep justified assertions for compiler limitations narrow; const assertions do not validate runtime input."
            },
            {
              "from": "Validate once where data crosses in. Trust types inside. See the **boundary-discipline** principle skill.",
              "to": "Validate external data at entry and rely on established invariants internally. Revalidate when a new trust boundary is crossed."
            },
            {
              "from": "- **Wire formats** (proto, JSON-RPC): parse with `ignoreUnknownFields` so forward-compatible changes don't break old clients.",
              "to": "- **Wire formats** (proto, JSON-RPC): follow the protocol's compatibility rules and the parser's supported options. Do not silently discard security-relevant unknown fields."
            }
          ]
        }
      ]
    },
